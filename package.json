{
  "name": "mrcat-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Static English learning app with CloudBase backend.",
  "scripts": {
    "verify": "node scripts/verify-release.js",
    "verify:release": "node scripts/verify-release.js",
    "test:vocabulary": "node scripts/test-vocabulary-versioning.js",
    "test:my-words": "node scripts/test-my-words-features.js",
    "test:student-accounts": "node scripts/test-student-account-lifecycle.js",
    "test:login-redirect": "node scripts/test-login-redirect.js",
    "test:assignment-schedule": "node scripts/test-assignment-due-weeks.js",
    "test:content-editions": "node scripts/test-content-editions.js",
    "test:learning-reports": "node scripts/test-learning-reports.js && node scripts/test-learning-report-service.js",
    "test:star-rewards": "node scripts/test-star-rewards.js",
    "test:self-study-completions": "node scripts/test-self-study-completions.js",
    "test:global-progress": "node scripts/test-global-exercise-progress.js",
    "test:protected-resources": "node scripts/test-protected-resource.js",
    "prepare:dse-topic-bank": "node scripts/prepare-protected-resource.js",
    "prepare:jupas-report": "node scripts/prepare-protected-resource.js --resource hk8-dse-jupas-weighting-2026-27",
    "package:functions": "node scripts/package-cloudfunctions.js",
    "package:functions:all": "node scripts/package-cloudfunctions.js --all",
    "release:plan": "node scripts/generate-deploy-plan.js",
    "cloudbase:import:content": "node scripts/cloudbase-import-content.js"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "5.5.2",
    "@cloudbase/node-sdk": "3.18.1",
    "esbuild": "0.25.6"
  }
}
